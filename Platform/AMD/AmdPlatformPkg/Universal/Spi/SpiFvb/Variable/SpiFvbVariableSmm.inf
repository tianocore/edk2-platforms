[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SpiFvbVariableSmm
  FILE_GUID                      = 7EF9447C-C5D4-4DFC-A86E-64B4A19C9892
  MODULE_TYPE                    = DXE_SMM_DRIVER
  VERSION_STRING                 = 1.0
  PI_SPECIFICATION_VERSION       = 0x0001000A
  ENTRY_POINT                    = SpiFvbVariableSmmEntryPoint

[Sources]
  ../SpiFvbCommon.c
  SpiFvbVariableSmm.c

[Packages]
  AmdPlatformPkg/AmdPlatformPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  AgesaModulePkg/AgesaModuleFchPkg.dec
  UefiCpuPkg/UefiCpuPkg.dec

[LibraryClasses]
  BaseLib
  PcdLib
  UefiLib
  UefiDriverEntryPoint
  SmmServicesTableLib
  DebugLib
  MemoryAllocationLib
  IoLib
  PciLib

[Pcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdFlashNvStorageVariableBase      ## CONSUMES

[FixedPcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdFlashNvStorageVariableSize      ## CONSUMES
  gEfiMdeModulePkgTokenSpaceGuid.PcdFlashNvStorageFtwWorkingSize    ## CONSUMES
  gEfiMdeModulePkgTokenSpaceGuid.PcdFlashNvStorageFtwSpareSize      ## CONSUMES
  gAmdPlatformPkgTokenSpaceGuid.PcdFlashNvStorageBlockSize          ## CONSUMES
  gAmdPlatformPkgTokenSpaceGuid.PcdFlashAreaBaseAddress             ## CONSUMES
  gAmdPlatformPkgTokenSpaceGuid.PcdRom3FlashAreaSize

[Protocols]
  gEfiSmmFirmwareVolumeBlockProtocolGuid                            ## PRODUCES
  gEfiSpiSmmNorFlashProtocolGuid                                    ## CONSUMES
  gAmdEspiSmmNorFlashProtocolGuid                                   ## CONSUMES

[Depex]
  gEfiSpiSmmNorFlashProtocolGuid OR
  gAmdEspiSmmNorFlashProtocolGuid

[UserExtensions.TianoCore."ExtraFiles"]
  SpiFvbVariableExtra.uni
