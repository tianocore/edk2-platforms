  FILE_GUID                      = B1DD2F34-DA6D-4B8D-9D1C-DCB76B6E400F
  MODULE_TYPE                    = DXE_SMM_DRIVER
  VERSION_STRING                 = 1.0
  PI_SPECIFICATION_VERSION       = 0x0001000A
  ENTRY_POINT                    = NvStoreRestoreDefaultEntry

#
#  VALID_ARCHITECTURES           = IA32 X64
#

[Sources]
  NvStoreRestoreDefaultSmm.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
