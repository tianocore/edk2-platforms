#langdef en-US "English"

#string STR_GET_HELP_SIDDUMP      #language en-US ""
".TH siddump 0 \"Dumps Allwinner H618 SID eFuse registers.\"\r\n"
".SH NAME\r\n"
"Dumps Allwinner H618 Security ID (SID) eFuse words at 0x03006000 (Usage: siddump [Offset] [Bytes]).\r\n"
