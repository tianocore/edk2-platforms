[LibraryClasses]
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  UefiDriverEntryPoint
  CN10KConfigLib
  SmcLib
  IoLib

[Guids]
  gCN10KPlatformTokenSpaceGuid
  gEfiEventExitBootServicesGuid

[Protocols]
  gEfiDevicePathFromTextProtocolGuid

[Pcd]
  gCN10KPlatformTokenSpaceGuid.PcdNodeCount
  gCN10KPlatformTokenSpaceGuid.PcdCoresPerNode

[Depex]
